# --- Модель ---------------------------------------------------------------
# Бесплатный ключ: https://console.groq.com/keys → Create API Key
GROQ_API_KEY=

# groq | openai | ollama | demo. Пусто — groq, если есть ключ, иначе ollama.
LLM_PROVIDER=
# Для groq: llama-3.3-70b-versatile · openai/gpt-oss-120b · llama-3.1-8b-instant
LLM_MODEL=
# Для openai (OpenRouter, LM Studio…): адрес и ключ сервиса
LLM_BASE_URL=
LLM_API_KEY=
LLM_TIMEOUT=60
# Если сервис недоступен из вашей сети: http://user:pass@host:port
LLM_PROXY=
# demo — если облако не ответило, продолжить на заготовках (страховка на показ)
LLM_FALLBACK=demo

# --- Ollama (LLM_PROVIDER=ollama) --------------------------------------------
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:31b-cloud
OLLAMA_TIMEOUT=180

# --- Генерация ---
TEMPERATURE=0.75
TOP_P=0.9
NUM_PREDICT=400

# --- Диалог ---
MAX_HISTORY_MESSAGES=24
SESSION_TTL_SECONDS=21600
MAX_MESSAGE_CHARS=4000

# --- Сервер ---
HOST=127.0.0.1
PORT=8000

# --- Защита ---
RATE_LIMIT_PER_MINUTE=30
